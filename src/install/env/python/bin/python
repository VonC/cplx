#!/bin/bash
# filepath: /c:/Users/vonc/prog/git/cplx/src/install/env/python/bin/python

# Define the debug echo function.
# It prints its arguments to stderr only if the P_DBG environment variable is set.
echo_dbg() {
    if [[ -n "${P_DBG}" ]]; then
        echo "DBG: $*" >&2
    fi
}

# The checked read (decision W4). `readlink` is the only helper whose RESULT the
# wrapper turns into a path, so an empty or failed read is what produces
# `current/bin/_bin`. This returns non-zero when the read FAILED or returned
# NOTHING, and every caller propagates that with `|| exit`: each call site is a
# command substitution, which runs in a subshell, so an `exit` HERE would end
# only that subshell and let the wrapper carry on with the empty value.
guarded_readlink() {
    local site="$1" path="$2" value
    if ! value="$(readlink "${path}")" || [[ -z "${value}" ]]; then
        echo "python: readlink failed at ${site}: '${path}'" >&2
        return 1
    fi
    printf '%s\n' "${value}"
}

DIR="$( cd "$( dirname "$(readlink -f "${BASH_SOURCE[0]}")" )" && pwd )"

echo "DIR='${DIR}'" >&2
if [[ ! -e "${DIR}/setenv" ]]; then exit 1; fi

# shellcheck source=/dev/null
source "${DIR}/setenv"

# SCOPE THE SHIPPED SEARCH PATH TO THE INTERPRETER (decision D2/W1).
#
# `setenv` exports LD_LIBRARY_PATH pointing at the shipped RHEL libraries. Every
# helper below (readlink, mv, ln, cp, sed, grep) is resolved through PATH and
# would inherit it, so on a foreign distribution the HOST helper binds the
# shipped libc and dies on GLIBC_PRIVATE. The interpreter needs that search
# path; nothing else this script runs does.
#
# Saved ONCE here, immediately after the source, and restored per interpreter
# invocation through a per-command assignment rather than an export, so THIS
# shell's environment stays unset and every helper below inherits that (W2).
#
# An empty value is preserved AS EMPTY rather than as unset (W3): a caller who
# had an empty one gets an empty one back. `${VAR-}` yields empty when unset, so
# one assignment covers both.
CPLX_TOOLCHAIN_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
unset LD_LIBRARY_PATH

# Check if any of the parameters are, in that order, '-m venv'
args=("$@")
venv=""
for (( i=0; i < ${#args[@]} - 2; i++ )); do
    if [[ "${args[i]}" == "-m" && "${args[i+1]}" == "venv" ]]; then
        venv="${args[i+2]}"
        break
    fi
done

python3_target="$(guarded_readlink relink-read \
    "${DIR}/current/bin/python3")" || exit
# If "${DIR}/current/bin/python3" is a file, move it and create a symlink pointing back to "${DIR}/python"
if [ "${python3_target}" != "../../bin/python" ]; then
    echo_dbg "mv '${DIR}/current/bin/${python3_target}' '${DIR}/current/bin/${python3_target}_bin'"
    mv "${DIR}/current/bin/${python3_target}" "${DIR}/current/bin/${python3_target}_bin"

    echo_dbg "ln -nfs '../../bin/python' '${DIR}/current/bin/python3'"
    ln -nfs "../../bin/python" "${DIR}/current/bin/python3"

    echo_dbg "ln -nfs '../../bin/python' '${DIR}/current/bin/${python3_target}'"
    ln -nfs "../../bin/python" "${DIR}/current/bin/${python3_target}"

    echo_dbg "ln -nfs '${python3_target}_bin' '${DIR}/current/bin/python3_target'"
    ln -nfs "${python3_target}_bin" "${DIR}/current/bin/python3_target"

    python3_target="${python3_target}_bin"
else
    python3_target="$(guarded_readlink target-read \
        "${DIR}/current/bin/python3_target")" || exit
fi

if [[ ! -e "${DIR}/pip" ]]; then
    echo_dbg "ln -nfs 'current/bin/pip3' '${DIR}/pip'"
    ln -nfs "current/bin/pip3" "${DIR}/pip"

    echo_dbg "ln -nfs 'current/bin/pip3' '${DIR}/pip3'"
    ln -nfs "current/bin/pip3" "${DIR}/pip3"
fi

# Finally, call the new binary.
#
# The two restore sites, one per arm. A per-command assignment is inherited by
# the interpreter and by everything it spawns, exactly as an export would be;
# what it does NOT do is change this shell's environment, so the helpers below
# and every later line still see no LD_LIBRARY_PATH.
if [[ -z "${VIRTUAL_ENV}" ]]; then
  LD_LIBRARY_PATH="${CPLX_TOOLCHAIN_LD_LIBRARY_PATH}" "${DIR}/current/bin/${python3_target}" "$@"
else
  LD_LIBRARY_PATH="${CPLX_TOOLCHAIN_LD_LIBRARY_PATH}" "${VIRTUAL_ENV}/bin/${python3_target}_bin" "$@"
fi

if [[ -n "${venv}" ]]; then
    python3_target="$(guarded_readlink venv-read \
        "$(pwd)/${venv}/bin/python3")" || exit

    echo_dbg "ln -nfs '${DIR}/python' '$(pwd)/${venv}/bin/${python3_target}'"
    ln -nfs "${DIR}/python" "$(pwd)/${venv}/bin/${python3_target}"

    echo_dbg "cp '${DIR}/current/bin/${python3_target}' '$(pwd)/${venv}/bin/${python3_target}_bin'"
    cp "${DIR}/current/bin/${python3_target}" "$(pwd)/${venv}/bin/${python3_target}_bin"

    echo_dbg "sed -i 's/${python3_target}_bin/${python3_target}/g' '$(pwd)/${venv}/bin/pip'* "
    sed -i "s/${python3_target}_bin/${python3_target}/g" "$(pwd)/${venv}/bin/pip"*
fi

if [[ -n ${VIRTUAL_ENV} && -e "${VIRTUAL_ENV}" ]]; then
    # Use grep -l to find files containing the pattern, then loop through them
    # This is safer and allows for per-file debug messages.
    echo_dbg "Searching for files with '_bin_bin' in '${VIRTUAL_ENV}/bin/' to correct them."
    # Use a subshell and process substitution to avoid issues with loops and pipes
    while IFS= read -r file_to_fix; do
        # Only perform sed on actual files, not symlinks
        if [[ -f "$file_to_fix" && ! -L "$file_to_fix" ]]; then
            echo_dbg "sed -i 's/_bin_bin/_bin/g' '${file_to_fix}'"
            sed -i 's/_bin_bin/_bin/g' "${file_to_fix}"
        fi
    done < <(grep -l "bin_bin" "${VIRTUAL_ENV}"/bin/* 2>/dev/null)
fi
